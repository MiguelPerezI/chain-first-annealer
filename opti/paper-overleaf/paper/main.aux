\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Chain-first annealer on one Tesla T4 unless noted; $k$ chains export at most $k$ nonempty domains. Parameters: $c_{\max }=20$--$40$, $S=4096$ (circle $1024$), $5000$--$20000$ moves per epoch, $\beta =5$, $\gamma =0.5$, $p_{\mathrm  {track}}=0.3$ (M\"obius: $\beta =1$, $p_{\mathrm  {track}}=0.5$). $^\dagger $Three rungs: cold $303$\,s ($662/864$), warm $814$\,s ($820$), guided $304$\,s (complete); a guided cold rung alone stalled at $858$. $^\ddagger $Warm from a $k=5$ cover ($36$\,s); eight $k=3$ runs stalled at $148/150$ (Section~\ref {sec:stall}). $^\S  $Eight-rung ladder on an RTX PRO 6000 ($S=64$ cold, $S=256$ guided). The $k=2$ plateaus stop at the coverage of the best two rectangles; the domains realising them are often not rectangles.}}{8}{table.caption.5}\protected@file@percent }
\newlabel{tab:annealer}{{2}{8}{Chain-first annealer on one Tesla T4 unless noted; $k$ chains export at most $k$ nonempty domains. Parameters: $c_{\max }=20$--$40$, $S=4096$ (circle $1024$), $5000$--$20000$ moves per epoch, $\beta =5$, $\gamma =0.5$, $p_{\mathrm {track}}=0.3$ (M\"obius: $\beta =1$, $p_{\mathrm {track}}=0.5$). $^\dagger $Three rungs: cold $303$\,s ($662/864$), warm $814$\,s ($820$), guided $304$\,s (complete); a guided cold rung alone stalled at $858$. $^\ddagger $Warm from a $k=5$ cover ($36$\,s); eight $k=3$ runs stalled at $148/150$ (Section~\ref {sec:stall}). $^\S $Eight-rung ladder on an RTX PRO 6000 ($S=64$ cold, $S=256$ guided). The $k=2$ plateaus stop at the coverage of the best two rectangles; the domains realising them are often not rectangles}{table.caption.5}{}}
