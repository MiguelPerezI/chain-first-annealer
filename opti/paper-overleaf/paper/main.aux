\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces \textsc  {ChainAnneal}($K$, $k$, $c_{\max }$; $S$, $\beta $, $\gamma $, $p_{\mathrm  {track}}$): anneal whole systems of $k$ chains over $K\times K$.}}{8}{algorithm.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{alg:anneal}{{1}{8}{\textsc {ChainAnneal}($K$, $k$, $c_{\max }$; $S$, $\beta $, $\gamma $, $p_{\mathrm {track}}$): anneal whole systems of $k$ chains over $K\times K$}{algorithm.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Chain-first annealer, complete covers, one Tesla T4 unless noted. The column $k$ is the number of chains the search anneals; $k$ chains export at most $k$ nonempty domains, and $k$ is not a proven minimal number of domains. On the simplex boundaries the star-rectangle constant is $\rho =3$ (Corollary~\ref {cor:spheres}); on the cube boundary $\rho =8$ (integer program, HiGHS solver certifying optimality), so the three domains found use five fewer domains than any cover by the star rectangles $D(v,w)$ of Theorem~\ref {thm:prod}. The circle time is the historical recorded value (Table~\ref {tab:params}), not a new measurement. Domain sizes are those of the certified cover. The per-run values of $c_{\max }$, the population size and the move budget are \emph  {not} uniform across rows; they are listed in Table~\ref {tab:params}. $^\dagger $The cube entry is a three-rung ladder totalling about $24$ minutes---cold rung ($303$\,s, $662/864$), warm rung ($814$\,s, $820/864$), guided warm rung ($304$\,s, complete); rungs, warm starts and guided weights are defined below. The $304$\,s quoted above is the final guided rung alone, not the whole sequence. $^\ddagger $Warm-started from a certified $5$-domain cover ($k{=}5$ cold, $36$\,s, epoch~$3$). Eight independent $k{=}3$ searches (cold, warm-restarted and guided) all stalled at $148/150$ facets; a companion note \cite  {PM26} reports a $3$-domain cover found by constraint programming. $^\S  $Eight-rung ladder on an NVIDIA RTX PRO 6000 Blackwell Server Edition (not the T4 used for all other rows): cold $5$-rung phase (${\approx }1$\,h\,$42$\,min, $S{=}64$), then guided $3$-rung continuation (${\approx }47$\,min, $S{=}256$).}}{9}{table.caption.1}\protected@file@percent }
\newlabel{tab:annealer}{{1}{9}{Chain-first annealer, complete covers, one Tesla T4 unless noted. The column $k$ is the number of chains the search anneals; $k$ chains export at most $k$ nonempty domains, and $k$ is not a proven minimal number of domains. On the simplex boundaries the star-rectangle constant is $\rho =3$ (Corollary~\ref {cor:spheres}); on the cube boundary $\rho =8$ (integer program, HiGHS solver certifying optimality), so the three domains found use five fewer domains than any cover by the star rectangles $D(v,w)$ of Theorem~\ref {thm:prod}. The circle time is the historical recorded value (Table~\ref {tab:params}), not a new measurement. Domain sizes are those of the certified cover. The per-run values of $c_{\max }$, the population size and the move budget are \emph {not} uniform across rows; they are listed in Table~\ref {tab:params}. $^\dagger $The cube entry is a three-rung ladder totalling about $24$ minutes---cold rung ($303$\,s, $662/864$), warm rung ($814$\,s, $820/864$), guided warm rung ($304$\,s, complete); rungs, warm starts and guided weights are defined below. The $304$\,s quoted above is the final guided rung alone, not the whole sequence. $^\ddagger $Warm-started from a certified $5$-domain cover ($k{=}5$ cold, $36$\,s, epoch~$3$). Eight independent $k{=}3$ searches (cold, warm-restarted and guided) all stalled at $148/150$ facets; a companion note \cite {PM26} reports a $3$-domain cover found by constraint programming. $^\S $Eight-rung ladder on an NVIDIA RTX PRO 6000 Blackwell Server Edition (not the T4 used for all other rows): cold $5$-rung phase (${\approx }1$\,h\,$42$\,min, $S{=}64$), then guided $3$-rung continuation (${\approx }47$\,min, $S{=}256$)}{table.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Two-chain plateau runs ($k=2$): the search seeks a cover by $2$ domains and stalls. Coverage counts maximal simplices of the ordered product. Equality with a two-star-rectangle coverage fraction does not imply that the same fraction of base-facet pairs is covered in its entirety; for example, \texttt  {s3\_k2\_v2\_point} covers $21$ of $25$ base-facet pairs completely and \texttt  {s4\_k2\_v2} covers $33$ of $36$. The plateau values recurred across the seeds and continuations we ran; these are observations on a finite set of runs, not a probability estimate.}}{10}{table.caption.2}\protected@file@percent }
\newlabel{tab:plateau}{{2}{10}{Two-chain plateau runs ($k=2$): the search seeks a cover by $2$ domains and stalls. Coverage counts maximal simplices of the ordered product. Equality with a two-star-rectangle coverage fraction does not imply that the same fraction of base-facet pairs is covered in its entirety; for example, \texttt {s3\_k2\_v2\_point} covers $21$ of $25$ base-facet pairs completely and \texttt {s4\_k2\_v2} covers $33$ of $36$. The plateau values recurred across the seeds and continuations we ran; these are observations on a finite set of runs, not a probability estimate}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Search parameters of the runs reported in Table~\ref {tab:annealer}; the first seven rows used $\beta =5$, $\gamma =0.5$ and $p_{\mathrm  {track}}=0.3$. The $S^6$ entry is the final rung of the $8$-rung ladder described in Table~\ref {tab:annealer}; earlier rungs escalated $c_{\max }$ from $16$ to $56$ and used $S{=}64$ in the cold phase ($750$ iterations~$\times $ $4$ epochs, full coverage at epoch~$2$). These settings should not be read back onto the circle run, which used $k=2$, $c_{\max }=40$, $S=1024$, $20000$ moves per epoch, seed $5$, $\beta =5$, $\gamma =0.5$ and $p_{\mathrm  {track}}=0.05$ (recorded wall time $7.9$\,s; certificate \texttt  {chain-first-annealer/opti/results/circle\_probe3}, chains of $4$ and $5$ links), nor onto the M\"obius band run, which used $\beta =1$, $\gamma =0.5$ and $p_{\mathrm  {track}}=0.5$.}}{10}{table.caption.3}\protected@file@percent }
\newlabel{tab:params}{{3}{10}{Search parameters of the runs reported in Table~\ref {tab:annealer}; the first seven rows used $\beta =5$, $\gamma =0.5$ and $p_{\mathrm {track}}=0.3$. The $S^6$ entry is the final rung of the $8$-rung ladder described in Table~\ref {tab:annealer}; earlier rungs escalated $c_{\max }$ from $16$ to $56$ and used $S{=}64$ in the cold phase ($750$ iterations~$\times $ $4$ epochs, full coverage at epoch~$2$). These settings should not be read back onto the circle run, which used $k=2$, $c_{\max }=40$, $S=1024$, $20000$ moves per epoch, seed $5$, $\beta =5$, $\gamma =0.5$ and $p_{\mathrm {track}}=0.05$ (recorded wall time $7.9$\,s; certificate \texttt {chain-first-annealer/opti/results/circle\_probe3}, chains of $4$ and $5$ links), nor onto the M\"obius band run, which used $\beta =1$, $\gamma =0.5$ and $p_{\mathrm {track}}=0.5$}{table.caption.3}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {2}{\ignorespaces \textsc  {WarmLadder}($K$, $k$, $c_{\max }$; $S$, $\beta $, $\gamma $, $p_{\mathrm  {track}}$; per-rung budget $T_{\mathrm  {rung}}$, guided increment $g$, cap $g_{\max }$, max rungs $R_{\max }$). Algorithm~\ref {alg:anneal} run as a ladder: warm seeding between rungs, guided reweighting within each rung.}}{12}{algorithm.2}\protected@file@percent }
\newlabel{alg:ladder}{{2}{12}{\textsc {WarmLadder}($K$, $k$, $c_{\max }$; $S$, $\beta $, $\gamma $, $p_{\mathrm {track}}$; per-rung budget $T_{\mathrm {rung}}$, guided increment $g$, cap $g_{\max }$, max rungs $R_{\max }$). Algorithm~\ref {alg:anneal} run as a ladder: warm seeding between rungs, guided reweighting within each rung}{algorithm.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Complete warm-start rung-ladder campaign on the dodecahedron boundary ($7776$ product facets of $K\times K$, $k=3$). Upper block: five long warm escalations ($c_{\max }=40$, $g=3$, $g_{\max }=11$), each reseeded from the previous incumbent. Lower block: $2.5$-minute ladder run unattended over $12$\,GPU-hours, summarised in batches of $20$ rungs; the final row combines the last partial batch with extended window probes and a $70$-trial basin survey. Mean gain per rung falls from $11.7$ in the first batch to below $1$ in the last; no complete cover was found. We conjecture that the obstacle is the sparsity of $K$: a dual-graph diameter of $7$ may require coordinated walks that become harder to satisfy simultaneously as coverage rises. This is a hypothesis; an unsuccessful campaign does not establish the cause.}}{13}{table.caption.4}\protected@file@percent }
\newlabel{tab:dodeca}{{4}{13}{Complete warm-start rung-ladder campaign on the dodecahedron boundary ($7776$ product facets of $K\times K$, $k=3$). Upper block: five long warm escalations ($c_{\max }=40$, $g=3$, $g_{\max }=11$), each reseeded from the previous incumbent. Lower block: $2.5$-minute ladder run unattended over $12$\,GPU-hours, summarised in batches of $20$ rungs; the final row combines the last partial batch with extended window probes and a $70$-trial basin survey. Mean gain per rung falls from $11.7$ in the first batch to below $1$ in the last; no complete cover was found. We conjecture that the obstacle is the sparsity of $K$: a dual-graph diameter of $7$ may require coordinated walks that become harder to satisfy simultaneously as coverage rises. This is a hypothesis; an unsuccessful campaign does not establish the cause}{table.caption.4}{}}
